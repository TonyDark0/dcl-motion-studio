+std::vector<float> read_condition(const std::string &path, size_t values) {
+    std::ifstream input(path, std::ios::binary | std::ios::ate);
+    if (!input || input.tellg()!=static_cast<std::streamoff>(values*sizeof(float)))
+        throw std::runtime_error("invalid constraint buffer size");
+    std::vector<float> result(values);
+    input.seekg(0); input.read(reinterpret_cast<char*>(result.data()),static_cast<std::streamsize>(values*sizeof(float)));
+    if (!input) throw std::runtime_error("cannot read constraint buffer");
+    return result;
 }
 
